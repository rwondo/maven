# API keys for the model providers you want to use. You only need the ones for the
# models you pass to --models (the default models use Together AI).
#
# MAVEN reads these from environment variables; it does not load this file by itself.
# Copy it to .env, fill in your keys, then export them in your shell (see README).
TOGETHER_API_KEY=your-together-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key
